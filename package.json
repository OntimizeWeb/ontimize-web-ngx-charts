{
  "name": "ontimize-web-ngx-charts",
  "version": "16.0.0-SNAPSHOT-0",
  "description": "An implementation of ngx-charts for Ontimize Web",
  "keywords": [
    "angular",
    "ontimize-web-ngx",
    "ontimize-web-ngx-charts",
    "charts",
    "ngx-charts"
  ],
  "author": "IMATIA S.L.",
  "repository": {
    "type": "git",
    "url": "git@github.com:OntimizeWeb/ontimize-web-ngx-charts.git"
  },
  "license": "Apache-2.0",
  "main": "./bundles/ontimize-web-ngx-charts.umd.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && scss-bundle -c scss-bundle-ontimize-charts.config.json && npm run copy-files",
    "build-prod": "ng build -c production && scss-bundle -c scss-bundle-ontimize-charts.config.json && npm run copy-files",
    "copy-files": "copyfiles -u 3 './projects/ontimize-web-ngx-charts/assets/*' ./dist/assets && echo '----¡Assets copied!----'  ",
    "test": "ng test --code-coverage",
    "test-ci": "ng test --no-watch --code-coverage --browsers ChromeHeadless",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/cdk": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/material": "^16.2.0",
    "@angular/material-moment-adapter": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@angular/flex-layout": "npm:@ngbracket/ngx-layout@^16.0.0",
    "@ngbracket/ngx-layout": "^16.0.0",
    "@swimlane/ngx-charts": "^20.5.0",
    "dom-to-image": "^2.6.0",
    "ontimize-web-ngx": "^15.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.0",
    "@angular-eslint/builder": "16.1.2",
    "@angular-eslint/eslint-plugin": "16.1.2",
    "@angular-eslint/eslint-plugin-template": "16.1.2",
    "@angular-eslint/schematics": "16.1.2",
    "@angular-eslint/template-parser": "16.1.2",
    "@angular/cli": "^16.2.0",
    "@angular/compiler-cli": "^16.2.0",
    "@angular/language-service": "^16.2.0",
    "@types/hammerjs": "~2.0.36",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "copyfiles": "~2.2.0",
    "eslint": "^8.28.0",
    "jasmine-core": "~4.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "karma-sonarqube-unit-reporter": "0.0.23",
    "moment": "^2.29.4",
    "ng-packagr": "^16.2.0",
    "scss-bundle": "3.1.1",
    "sonarqube-scanner": "^2.8.1",
    "ts-node": "~10.9.0",
    "typescript": "~5.0.4"
  }
}
